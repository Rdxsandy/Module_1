# Copy to .env and edit as needed
# Use Neon's DIRECT endpoint (no "-pooler" in the hostname) — this app pools
# its own connections, and PgBouncer's transaction-pooling mode (the pooler
# endpoint) is incompatible with asyncpg's server-side prepared statements.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-12345.us-east-2.aws.neon.tech/dbname?sslmode=require
APP_TITLE=CCTV GIS PoC
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT - CHANGE THIS to a long random string in production!
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_EXPIRE_MINUTES=120

# RabbitMQ broker for async event ingestion (Celery)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Colab ANPR inference service (Ngrok tunnel — changes each time Colab restarts)
COLAB_ANPR_URL=https://your-ngrok-subdomain.ngrok-free.dev/predict
