# Copy to .env and edit as needed
# Use Neon's DIRECT endpoint (no "-pooler" in the hostname) — this app pools
# its own connections, and PgBouncer's transaction-pooling mode (the pooler
# endpoint) is incompatible with asyncpg's server-side prepared statements.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-12345.us-east-2.aws.neon.tech/dbname?sslmode=require
APP_TITLE=CCTV GIS PoC
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT - CHANGE THIS to a long random string in production!
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_EXPIRE_MINUTES=120

# RabbitMQ broker for async event ingestion (Celery)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# --- Shared VMS (e.g. Sentinel) credentials — set ONCE here instead of
# pasting rtsp://user:pass@... into every camera's stream_url. Each Camera
# then just stores which channel number (1..VMS_CHANNEL_COUNT) it maps to
# (see app/services/vms_service.py, and the "VMS Channel" field on the
# Cameras page's Edit form). Leaving VMS_HOST unset just disables the
# channel picker — manual per-camera stream_url still works either way.
VMS_HOST=
VMS_PORT=554
# Raw values only — do NOT percent-encode here (e.g. an email's "@" stays
# as "@", not "%40"). resolve_stream_url() encodes both automatically when
# building the actual RTSP URL, so special characters (including "@" in an
# email-as-username) just work.
VMS_USERNAME=
VMS_PASSWORD=
VMS_CHANNEL_COUNT=30
# {username} {password} {host} {port} {channel} are substituted in (already
# percent-encoded for username/password). The default below is a common
# Dahua/HikVision-style NVR pattern — check your VMS's own documentation
# for the exact path it actually uses, since this varies by vendor. Another
# real-world example, for a VMS whose channels are named cam01..cam30 with
# a zero-padded 2-digit id (Python's format-spec :02d handles the padding):
#   VMS_URL_TEMPLATE=rtsp://{username}:{password}@{host}:{port}/stream/cam{channel:02d}
VMS_URL_TEMPLATE=rtsp://{username}:{password}@{host}:{port}/cam/realmonitor?channel={channel}&subtype=0

# --- Legacy Colab ANPR service — unused now that ANPR runs locally via
# YOLOv8 + EasyOCR (see rtsp_source.py). Left here only for the commented-out
# rollback path.
COLAB_ANPR_URL=https://your-ngrok-subdomain.ngrok-free.dev/predict
ANPR_FRAME_INTERVAL=1.0

# Minimum confidence (0.0-1.0) for an EasyOCR plate read to become an event.
# Kept at 0.0 (no filtering) until real-world confidence scores are tuned.
ANPR_MIN_CONFIDENCE=0.0

# Run YOLO+OCR inference every Nth frame at minimum, even with no motion
# (covers a stopped vehicle in frame). The motion filter below is what
# skips most frames in between — this is just the ceiling.
ANPR_FRAME_SKIP=5

# --- Region of Interest — as fractions (0.0-1.0) of frame width/height.
# Default is the full frame. Tune per camera to crop out sky/trees above
# the road: e.g. a fixed overhead camera might use ANPR_ROI_Y_START=0.4 to
# skip the top 40% of the frame, cutting YOLO's per-frame cost.
ANPR_ROI_X_START=0.0
ANPR_ROI_Y_START=0.0
ANPR_ROI_X_END=1.0
ANPR_ROI_Y_END=1.0

# Fraction of ROI pixels that must change (background subtraction) before
# a frame is worth running YOLO on. Raise if static background triggers
# false "motion"; lower if slow-moving vehicles get missed.
ANPR_MOTION_THRESHOLD=0.02

# --- Vehicle tracker — limits how many times EasyOCR runs per vehicle
# instead of once per frame it's visible.
ANPR_TRACK_IOU_THRESHOLD=0.3
ANPR_TRACK_MAX_AGE=15
ANPR_TRACK_MAX_ATTEMPTS=3

# EasyOCR struggles with tiny text — plate crops smaller than this (pixels,
# longest side) are upscaled before OCR.
ANPR_MIN_OCR_DIM=200

# Base/max seconds between reconnect attempts for a live (RTSP/webcam)
# source after it drops or fails to open — exponential backoff (doubles
# each failed attempt, resets after a connection actually delivers a
# frame), never a tight loop against a camera that's genuinely down.
# Uploaded video files never reconnect.
ANPR_RECONNECT_DELAY=2.0
ANPR_RECONNECT_MAX_DELAY=30.0

# Seconds to wait for an RTSP connection before giving up (FFmpeg's own
# default can hang far longer against a dead/unreachable camera).
ANPR_RTSP_CONNECT_TIMEOUT=5.0

# Use ONNX Runtime for YOLO inference on CPU-only boxes (auto-exports
# yolov8n.pt -> yolov8n.onnx once). Ignored when a GPU is available, where
# native PyTorch + CUDA is faster.
ANPR_USE_ONNX=true
